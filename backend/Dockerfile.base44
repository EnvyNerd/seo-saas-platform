FROM python:3.12-slim

WORKDIR /app/backend

# Install build tools for any C-extension packages without pre-built wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (source is bind-mounted at runtime, NOT baked in)
COPY requirements.base44.txt .
RUN pip install --no-cache-dir -r requirements.base44.txt

EXPOSE 8000
